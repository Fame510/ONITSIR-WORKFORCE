# agentosirus-web environment
#
# Copy to .env.local and fill in only what you need. Every variable is optional.
# .env.local is gitignored. Never commit real keys.
#
# WARNING: everything prefixed VITE_ is inlined into the client bundle and is
# visible to anyone who loads the page. Treat any key here as exposed. For a
# deployment where keys must stay secret, proxy provider calls through
# onitsir-server instead of setting them here.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# Unset -> offline/static mode: apiShim.ts answers /api/* in the browser.
# Set   -> governed mode: calls go to onitsir-server and pass through SHACKLE.
# VITE_BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# LLM providers (optional, offline mode only needs these for live dispatch)
# ---------------------------------------------------------------------------
# VITE_OPENAI_API_KEY=
# VITE_ANTHROPIC_API_KEY=
# VITE_GOOGLE_API_KEY=
# VITE_GROQ_API_KEY=
# VITE_MISTRAL_API_KEY=
# VITE_OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Tool integrations (optional)
# ---------------------------------------------------------------------------
# VITE_GITHUB_TOKEN=
# VITE_FIRECRAWL_API_KEY=
# VITE_KLINGAI_API_KEY=

# Companion service (Playwright / media). Only needed if you run infra/Dockerfile.companion.
# VITE_COMPANION_URL=http://localhost:8787
