{
  "name": "agentosirus-web",
  "version": "3.0.0",
  "description": "The execution surface + human interface half of the unified ONITSIR system: specialist prompt library, multi-provider LLM dispatch, tool integrations, and all UI. Can run static/offline (client-only) or backed by onitsir-server (governed mode).",
  "type": "module",
  "scripts": {
    "build:index": "node scripts/build-agent-index.mjs",
    "dev": "npm run build:index && vite",
    "build": "npm run build:index && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:diagnostic": "vitest run --reporter=verbose",
    "conformance:check": "node scripts/conformance-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.435.0",
    "motion": "^11.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^2.0.5",
    "jsdom": "^25.0.0"
  }
}
