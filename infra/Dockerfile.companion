# infra/Dockerfile.companion
#
# Build context is packages/agentosirus-web/companion.
#
#   docker build -f infra/Dockerfile.companion packages/agentosirus-web/companion
#
FROM node:20-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
# This service has no committed lockfile, so npm install is correct here.
RUN npm install --omit=dev

COPY . /app

EXPOSE 8787

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
    CMD curl -fsS http://localhost:8787/health || exit 1

CMD ["node", "server.mjs"]
